# Copy this file to .env and fill in the values. Never commit .env.
# JDBC URL of the Neon database, without user and password.
DB_URL=jdbc:postgresql://<host>/neondb?sslmode=require
DB_USERNAME=
DB_PASSWORD=
# URL of auxia-ai-service (default http://localhost:8765) and the same API key it uses.
AI_SERVICE_URL=http://localhost:8765
AI_SERVICE_API_KEY=
# Base64 secret of at least 32 bytes that signs the access tokens (JWT).
# Generate one with: openssl rand -base64 32
AUTH_JWT_SECRET=
# Secret of the platform operator to register and suspend organizations.
PLATFORM_ADMIN_KEY=
# Evidence files of the deliveries: connection string of the Azure Storage account.
# Locally, Azurite: docker run -d -p 10000:10000 mcr.microsoft.com/azure-storage/azurite azurite-blob --blobHost 0.0.0.0
# and use its development connection string (see the README).
AZURE_STORAGE_CONNECTION_STRING=
# Blockchain where the hashes of the deliveries are anchored (Sepolia by default).
# JSON-RPC URL of Alchemy or Infura, and the private key of the wallet that owns the contract.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=

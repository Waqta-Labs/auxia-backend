# Copy this file to .env and fill in the values. Never commit .env.
# JDBC URL of the Neon database, without user and password.
DB_URL=jdbc:postgresql://<host>/neondb?sslmode=require
DB_USERNAME=
DB_PASSWORD=
# URL of auxia-ai-service (default http://localhost:8765) and the same API key it uses.
AI_SERVICE_URL=http://localhost:8765
AI_SERVICE_API_KEY=
